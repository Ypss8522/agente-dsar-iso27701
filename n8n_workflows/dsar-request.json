{
  "name": "DSAR - registro seguro de solicitudes",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "nodes": [
    {
      "id": "dsar-webhook",
      "name": "Recibir DSAR",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "dsar-request",
      "parameters": {
        "httpMethod": "POST",
        "path": "dsar-request",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR_WEBHOOK",
          "name": "DSAR Webhook"
        }
      }
    },
    {
      "id": "dsar-create",
      "name": "Crear ticket en Flask",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5000/api/requests",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.headers['idempotency-key'] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 8000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR_BACKEND",
          "name": "DSAR Backend"
        }
      }
    },
    {
      "id": "dsar-response",
      "name": "Responder ticket real",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        520,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\":\"{{ $json.body.status }}\",\"ticket_id\":\"{{ $json.body.data ? $json.body.data.ticket_id : '' }}\"}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      }
    }
  ],
  "connections": {
    "Recibir DSAR": {
      "main": [
        [
          {
            "node": "Crear ticket en Flask",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Crear ticket en Flask": {
      "main": [
        [
          {
            "node": "Responder ticket real",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
